# Database Configuration
# Local database url default (when using docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/projeto_saas
# Produção: credencial administrativa usada apenas pelo entrypoint e removida antes da API iniciar
MIGRATION_DATABASE_URL=
DATABASE_APP_ROLE=saas_app_user
SUPABASE_URL=https://rtysmuxbscxrgpwzqmwy.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Security
JWT_SECRET=super-secret-key-change-in-production
DATA_ENCRYPTION_KEY=separate-random-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=projeto-saas-api
JWT_AUDIENCE=projeto-saas-web
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ENVIRONMENT=development
PORT=8000

# WhatsApp / Billing Integrations
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
ASAAS_WEBHOOK_SECRET=
# Use https://api-sandbox.asaas.com/v3 para homologacao e https://api.asaas.com/v3 para producao.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# So habilite depois que os testes reais no Sandbox passarem.
ASAAS_BILLING_ENABLED=false

# Backups (use an absolute persistent volume in production)
BACKUP_DIR=
BACKUP_ENCRYPTION_KEY=
